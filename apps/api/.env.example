# Environnement
NODE_ENV=development
PORT=3000

# Base de données (SQLite en dev ; passer à postgresql en prod)
DATABASE_URL="file:./dev.db"

# Auth — remplacer par une valeur longue et aléatoire en production
JWT_SECRET="change-me-32-chars-min-secret-key"
JWT_EXPIRES_IN="15m"

# Origines autorisées (CORS) — séparées par des virgules
CORS_ORIGINS="http://localhost:5173,http://localhost:8081"
